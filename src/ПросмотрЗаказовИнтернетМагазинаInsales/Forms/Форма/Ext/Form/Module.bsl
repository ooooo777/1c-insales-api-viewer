#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВосстановитьНастройкиИзХранилища();

	Если Таймаут = 0 Тогда
		Таймаут = 60;
	КонецЕсли;

	Если РазмерСтраницы = 0 Тогда
		РазмерСтраницы = 100;
	КонецЕсли;

	Если ПределСтраниц = 0 Тогда
		ПределСтраниц = 50;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПериодС) Тогда
		ПериодС = НачалоДня(ТекущаяДата() - 7 * 24 * 3600);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПериодПо) Тогда
		ПериодПо = КонецДня(ТекущаяДата());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	// При завершении работы приложения серверные вызовы запрещены, и обращение
	// к хранилищу отсюда вызвало бы ошибку. Настройки к этому моменту уже сохранены:
	// это делают проверка связи и загрузка заказов.
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	СохранитьНастройкиВХранилище();

КонецПроцедуры

// Ключ, под которым настройки лежат в хранилище общих настроек. Собственное имя нужно
// потому, что у внешней обработки, открытой из файла, нет ключа объекта конфигурации:
// штатное сохранение данных формы для неё не работает.
//
// Возвращаемое значение:
//  Строка - ключ объекта настроек.
//
&НаКлиентеНаСервереБезКонтекста
Функция КлючНастроек()

	Возврат "ПросмотрЗаказовИнтернетМагазинаInsales";

КонецФункции

// Сохраняет адрес магазина, идентификатор ключа и параметры отбора.
// Пароль ключа не сохраняется никогда: он вводится каждый сеанс.
//
&НаСервере
Процедура СохранитьНастройкиВХранилище()

	Настройки = Новый Структура;
	Настройки.Вставить("АдресМагазина", АдресМагазина);
	Настройки.Вставить("ИдентификаторКлюча", ИдентификаторКлюча);
	Настройки.Вставить("Таймаут", Таймаут);
	Настройки.Вставить("РазмерСтраницы", РазмерСтраницы);
	Настройки.Вставить("ПределСтраниц", ПределСтраниц);

	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "", Настройки);
	Исключение
		// Права на сохранение настроек может не быть: тогда обработка просто
		// откроется в следующий раз с пустыми полями.
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиИзХранилища()

	Попытка
		Настройки = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "");
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Значение = "";
	Если Настройки.Свойство("АдресМагазина", Значение) Тогда
		АдресМагазина = Значение;
	КонецЕсли;
	Если Настройки.Свойство("ИдентификаторКлюча", Значение) Тогда
		ИдентификаторКлюча = Значение;
	КонецЕсли;
	Если Настройки.Свойство("Таймаут", Значение) Тогда
		Таймаут = Значение;
	КонецЕсли;
	Если Настройки.Свойство("РазмерСтраницы", Значение) Тогда
		РазмерСтраницы = Значение;
	КонецЕсли;
	Если Настройки.Свойство("ПределСтраниц", Значение) Тогда
		ПределСтраниц = Значение;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСвязь(Команда)

	РезультатПроверки = ПроверитьСвязьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗаказы(Команда)

	Если ИдетЗагрузка Тогда
		Возврат;
	КонецЕсли;

	Заказы.Очистить();
	НомерТекущейСтраницы = 1;
	ПопыткаСтраницы = 1;
	ИдетЗагрузка = Истина;
	СостояниеЗагрузки = "Загрузка начата";

	ПодключитьОбработчикОжидания("ЗагрузитьСледующуюСтраницу", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПрерватьЗагрузку(Команда)

	Если Не ИдетЗагрузка Тогда
		Возврат;
	КонецЕсли;

	ИдетЗагрузка = Ложь;
	СостояниеЗагрузки = "Прервано пользователем. Загружено заказов: "
		+ Формат(Заказы.Количество(), "ЧГ=0; ЧН=0");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СохранитьНастройкиВФайл(Команда)

	Адрес = АдресНастроекВХранилище();
	Если ПустаяСтрока(Адрес) Тогда
		ПоказатьПредупреждение(, "Не удалось подготовить файл настроек.");
		Возврат;
	КонецЕсли;

	СохранитьФайлСПодтверждением(Адрес, ИмяФайлаНастроек(), "Сохранение настроек просмотра заказов",
		"Настройки просмотра заказов (*.json)|*.json", "Настройки сохранены");

КонецПроцедуры

// Сохраняет файл из временного хранилища и сообщает пользователю результат.
// Варианты получения файла с диалогом «Открыть или сохранить» не сообщают, что выбрал
// пользователь, поэтому путь спрашивается отдельным диалогом, а файл пишется вариантом
// без диалога: только он вызывает обработчик завершения.
//
// Параметры:
//  Адрес - Строка - адрес файла во временном хранилище.
//  ИмяФайла - Строка - имя, предлагаемое в диалоге.
//  ЗаголовокДиалога - Строка - заголовок окна выбора пути.
//  Фильтр - Строка - фильтр типов файлов для диалога.
//  ТекстУспеха - Строка - текст оповещения после записи файла.
//
&НаКлиенте
Процедура СохранитьФайлСПодтверждением(Адрес, ИмяФайла, ЗаголовокДиалога, Фильтр, ТекстУспеха)

	#Если ВебКлиент Тогда
	// Без расширения работы с файлами путь в браузере не выбрать: файл сохраняет браузер,
	// и результат обработке неизвестен, поэтому сообщения об успехе здесь нет.
	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыДиалога.Заголовок = ЗаголовокДиалога;
	НачатьПолучениеФайлаССервера(Адрес, ИмяФайла, ПараметрыДиалога);
	#Иначе
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = ЗаголовокДиалога;
	Диалог.ПолноеИмяФайла = ИмяФайла;
	Диалог.Фильтр = Фильтр;

	Контекст = Новый Структура("Адрес, ТекстУспеха, Путь", Адрес, ТекстУспеха, "");
	Диалог.Показать(Новый ОписаниеОповещения("СохранитьФайлПутьВыбран", ЭтотОбъект, Контекст));
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлПутьВыбран(ВыбранныеФайлы, Контекст) Экспорт

	Если ТипЗнч(ВыбранныеФайлы) <> Тип("Массив") Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Контекст.Путь = ВыбранныеФайлы[0];
	Оповещение = Новый ОписаниеОповещения("СохранитьФайлЗавершение", ЭтотОбъект, Контекст);
	НачатьПолучениеФайлаССервера(Оповещение, Контекст.Адрес, Контекст.Путь);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлЗавершение(ПолученныйФайл, Контекст) Экспорт

	Если ПолученныйФайл = Неопределено Тогда
		ПоказатьПредупреждение(, "Файл не сохранён: " + Контекст.Путь);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(Контекст.ТекстУспеха, , Контекст.Путь);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиИзФайла(Команда)

	Оповещение = Новый ОписаниеОповещения("ЗагрузитьНастройкиЗавершение", ЭтотОбъект);

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Загрузка настроек просмотра заказов";
	ПараметрыДиалога.Фильтр = "Настройки просмотра заказов (*.json)|*.json";

	НачатьПомещениеФайлаНаСервер(Оповещение, , , , ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиЗавершение(ОписаниеФайла, ДополнительныеПараметры) Экспорт

	Если ОписаниеФайла = Неопределено Или ОписаниеФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	Сообщение = ПрименитьНастройкиИзХранилища(ОписаниеФайла.Адрес);
	Если ЗначениеЗаполнено(Сообщение) Тогда
		ПоказатьПредупреждение(, Сообщение);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя("Настройки загружены", , "Магазин: " + АдресМагазина);

КонецПроцедуры

// Настройки в виде текста. Пароль ключа в файл не попадает никогда:
// ключ даёт полный доступ к магазину, и хранить его в файле рядом с адресом нельзя.
//
// Возвращаемое значение:
//  Строка - текст JSON с настройками подключения и отбора.
//
&НаСервере
Функция НастройкиВТекст()

	Настройки = Новый Структура;
	Настройки.Вставить("АдресМагазина", АдресМагазина);
	Настройки.Вставить("ИдентификаторКлюча", ИдентификаторКлюча);
	Настройки.Вставить("Таймаут", Таймаут);
	Настройки.Вставить("РазмерСтраницы", РазмерСтраницы);
	Настройки.Вставить("ПределСтраниц", ПределСтраниц);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, Настройки);

	Возврат Запись.Закрыть();

КонецФункции

// Применяет настройки из текста.
//
// Параметры:
//  Текст - Строка - текст JSON с настройками.
//
// Возвращаемое значение:
//  Строка - пустая строка при успехе, иначе текст для пользователя.
//
&НаСервере
Функция ПрименитьНастройкиИзТекста(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "Файл настроек пуст.";
	КонецЕсли;

	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = Обработка.ПрочитатьОтветВСоответствие(Текст);

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат "Файл не похож на настройки этой обработки.";
	КонецЕсли;

	АдресИзФайла = Данные.Получить("АдресМагазина");
	Если АдресИзФайла <> Неопределено Тогда
		АдресМагазина = Строка(АдресИзФайла);
	КонецЕсли;

	ИдентификаторИзФайла = Данные.Получить("ИдентификаторКлюча");
	Если ИдентификаторИзФайла <> Неопределено Тогда
		ИдентификаторКлюча = Строка(ИдентификаторИзФайла);
	КонецЕсли;

	ТаймаутИзФайла = Данные.Получить("Таймаут");
	Если ТаймаутИзФайла <> Неопределено Тогда
		Таймаут = Обработка.ЧислоИзОтвета(ТаймаутИзФайла);
	КонецЕсли;

	РазмерИзФайла = Данные.Получить("РазмерСтраницы");
	Если РазмерИзФайла <> Неопределено Тогда
		РазмерСтраницы = Обработка.ЧислоИзОтвета(РазмерИзФайла);
	КонецЕсли;

	ПределИзФайла = Данные.Получить("ПределСтраниц");
	Если ПределИзФайла <> Неопределено Тогда
		ПределСтраниц = Обработка.ЧислоИзОтвета(ПределИзФайла);
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Функция ПрименитьНастройкиИзХранилища(Адрес)

	Попытка
		Данные = ПолучитьИзВременногоХранилища(Адрес);
		Чтение = Новый ЧтениеТекста(Данные.ОткрытьПотокДляЧтения(), "UTF-8");
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Возврат "Файл настроек не прочитан.";
	КонецПопытки;

	Возврат ПрименитьНастройкиИзТекста(Текст);

КонецФункции

&НаСервере
Функция АдресНастроекВХранилище()

	Попытка
		Поток = Новый ПотокВПамяти;
		// Текст JSON уже содержит переводы строк CRLF: без явных разделителей
		// запись добавила бы перед каждым LF ещё один CR.
		Запись = Новый ЗаписьТекста(Поток, "UTF-8", Символы.ПС, "");
		Запись.Записать(НастройкиВТекст());
		Запись.Закрыть();
		Данные = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяФайлаНастроек()

	Возврат "nastrojki-prosmotra-zakazov.json";

КонецФункции

&НаКлиенте
Процедура СохранитьСыройОтвет(Команда)

	Если ПустаяСтрока(СыройОтвет) Тогда
		ПоказатьПредупреждение(, "Сначала выберите заказ в списке.");
		Возврат;
	КонецЕсли;

	Адрес = АдресСырогоОтветаВХранилище();
	Если ПустаяСтрока(Адрес) Тогда
		ПоказатьПредупреждение(, "Не удалось подготовить файл с ответом магазина.");
		Возврат;
	КонецЕсли;

	СохранитьФайлСПодтверждением(Адрес, ИмяФайлаСырогоОтвета(), "Сохранение ответа магазина",
		"Ответ магазина (*.json)|*.json", "Ответ магазина сохранён");

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВТабличныйДокумент(Команда)

	Если Заказы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала загрузите заказы.");
		Возврат;
	КонецЕсли;

	Документ = СобратьТабличныйДокументНаСервере();
	Документ.Показать("Заказы интернет-магазина");

КонецПроцедуры

&НаСервере
Функция АдресСырогоОтветаВХранилище()

	Если ПустаяСтрока(СыройОтвет) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Поток = Новый ПотокВПамяти;
		// Текст JSON уже содержит переводы строк CRLF: без явных разделителей
		// запись добавила бы перед каждым LF ещё один CR.
		Запись = Новый ЗаписьТекста(Поток, "UTF-8", Символы.ПС, "");
		Запись.Записать(СыройОтвет);
		Запись.Закрыть();
		Данные = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяФайлаСырогоОтвета()

	Возврат "otvet-magazina.json";

КонецФункции

// Собирает лист со списком заказов и составом выделенного заказа.
// Макет не нужен: заголовки и значения выводятся прямо в ячейки.
//
// Возвращаемое значение:
//  ТабличныйДокумент - готовый к показу и сохранению лист.
//
&НаСервере
Функция СобратьТабличныйДокументНаСервере()

	Документ = Новый ТабличныйДокумент;
	Документ.ОтображатьСетку = Ложь;
	Документ.ИмяПараметровПечати = "ПросмотрЗаказовИнтернетМагазинаInsales";

	НомерСтроки = 1;

	Шапка = Документ.Область(НомерСтроки, 1);
	Шапка.Текст = "Заказы интернет-магазина";
	Шапка.Шрифт = Новый Шрифт(, , Истина);
	НомерСтроки = НомерСтроки + 1;

	Период = Документ.Область(НомерСтроки, 1);
	Период.Текст = "Изменены с " + Формат(ПериодС, "ДЛФ=DT") + " по " + Формат(ПериодПо, "ДЛФ=DT");
	НомерСтроки = НомерСтроки + 2;

	ЗаголовкиСписка = Новый Массив;
	ЗаголовкиСписка.Добавить("Номер на сайте");
	ЗаголовкиСписка.Добавить("Создан");
	ЗаголовкиСписка.Добавить("Изменён");
	ЗаголовкиСписка.Добавить("Покупатель");
	ЗаголовкиСписка.Добавить("Сумма");
	ЗаголовкиСписка.Добавить("Оплачен");
	ЗаголовкиСписка.Добавить("Статус");
	ЗаголовкиСписка.Добавить("Служба доставки");
	ЗаголовкиСписка.Добавить("Строк");

	ВывестиЗаголовки(Документ, НомерСтроки, ЗаголовкиСписка);
	НомерСтроки = НомерСтроки + 1;

	Для Каждого СтрокаЗаказа Из Заказы Цикл
		Значения = Новый Массив;
		Значения.Добавить(СтрокаЗаказа.НомерНаСайте);
		Значения.Добавить(Формат(СтрокаЗаказа.Создан, "ДЛФ=DT"));
		Значения.Добавить(Формат(СтрокаЗаказа.Изменен, "ДЛФ=DT"));
		Значения.Добавить(СтрокаЗаказа.Покупатель);
		Значения.Добавить(Формат(СтрокаЗаказа.Сумма, "ЧДЦ=2; ЧН=0"));
		Значения.Добавить(?(СтрокаЗаказа.Оплачен, "да", "нет"));
		Значения.Добавить(СтрокаЗаказа.СтатусВыполнения);
		Значения.Добавить(СтрокаЗаказа.СлужбаДоставки);
		Значения.Добавить(Формат(СтрокаЗаказа.ЧислоСтрок, "ЧГ=0; ЧН=0"));
		ВывестиЗначения(Документ, НомерСтроки, Значения);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Если СтрокиЗаказа.Количество() > 0 Тогда

		НомерСтроки = НомерСтроки + 2;
		Подзаголовок = Документ.Область(НомерСтроки, 1);
		Подзаголовок.Текст = "Состав выделенного заказа";
		Подзаголовок.Шрифт = Новый Шрифт(, , Истина);
		НомерСтроки = НомерСтроки + 1;

		ЗаголовкиСостава = Новый Массив;
		ЗаголовкиСостава.Добавить("Артикул");
		ЗаголовкиСостава.Добавить("Наименование");
		ЗаголовкиСостава.Добавить("Ключ сопоставления");
		ЗаголовкиСостава.Добавить("Штрихкод");
		ЗаголовкиСостава.Добавить("Количество");
		ЗаголовкиСостава.Добавить("Цена");
		ЗаголовкиСостава.Добавить("Сумма");

		ВывестиЗаголовки(Документ, НомерСтроки, ЗаголовкиСостава);
		НомерСтроки = НомерСтроки + 1;

		Для Каждого СтрокаСостава Из СтрокиЗаказа Цикл
			Значения = Новый Массив;
			Значения.Добавить(СтрокаСостава.Артикул);
			Значения.Добавить(СтрокаСостава.Наименование);
			Значения.Добавить(СтрокаСостава.КлючСопоставления);
			Значения.Добавить(СтрокаСостава.Штрихкод);
			Значения.Добавить(Формат(СтрокаСостава.Количество, "ЧДЦ=3; ЧН=0"));
			Значения.Добавить(Формат(СтрокаСостава.Цена, "ЧДЦ=2; ЧН=0"));
			Значения.Добавить(Формат(СтрокаСостава.Сумма, "ЧДЦ=2; ЧН=0"));
			ВывестиЗначения(Документ, НомерСтроки, Значения);
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;

	КонецЕсли;

	Возврат Документ;

КонецФункции

&НаСервере
Процедура ВывестиЗаголовки(Документ, НомерСтроки, Заголовки)

	// Имя переменной цикла не «Заголовок»: так называется свойство управляемой формы,
	// и присваивание в модуле формы меняло бы заголовок окна.
	НомерКолонки = 1;
	Для Каждого ТекстКолонки Из Заголовки Цикл
		Ячейка = Документ.Область(НомерСтроки, НомерКолонки);
		Ячейка.Текст = ТекстКолонки;
		Ячейка.Шрифт = Новый Шрифт(, , Истина);
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиЗначения(Документ, НомерСтроки, Значения)

	НомерКолонки = 1;
	Для Каждого Значение Из Значения Цикл
		Документ.Область(НомерСтроки, НомерКолонки).Текст = Значение;
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Заказы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьКарточкуНаСервере(ТекущиеДанные.СырыеДанные);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКарточкуНаСервере(СырыеДанныеЗаказа)

	ОчиститьКарточку();

	Если ПустаяСтрока(СырыеДанныеЗаказа) Тогда
		Возврат;
	КонецЕсли;

	Обработка = РеквизитФормыВЗначение("Объект");

	СыройЗаказ = Обработка.ПрочитатьОтветВСоответствие(СырыеДанныеЗаказа);
	Если ТипЗнч(СыройЗаказ) <> Тип("Соответствие") Тогда
		СыройОтвет = СырыеДанныеЗаказа;
		Возврат;
	КонецЕсли;

	Разбор = Обработка.РазобратьЗаказ(ИмяПлощадки(), СыройЗаказ);

	СтрокиЗаказа.Загрузить(Разбор.Строки);
	ДополнительныеПоляЗаказа.Загрузить(Разбор.ДополнительныеПоля);

	ПокупательФамилия = Разбор.Покупатель.Фамилия;
	ПокупательИмя = Разбор.Покупатель.Имя;
	ПокупательТелефон = Разбор.Покупатель.Телефон;
	ПокупательПочта = Разбор.Покупатель.Почта;
	ПокупательИНН = Разбор.Покупатель.ИНН;
	ПокупательКПП = Разбор.Покупатель.КПП;
	ПокупательАдрес = Разбор.Покупатель.Адрес;

	ДоставкаСлужба = Разбор.Доставка.Служба;
	ДоставкаКодСлужбы = Разбор.Доставка.МашинныйКодСлужбы;
	ДоставкаПунктВыдачи = Разбор.Доставка.ПунктВыдачи;
	ДоставкаСтоимость = Разбор.Доставка.Стоимость;
	ДоставкаДата = Разбор.Доставка.Дата;
	ДоставкаОписание = Разбор.Доставка.Описание;

	ОплатаСостояние = Разбор.Оплата.Состояние;
	ОплатаОписание = Разбор.Оплата.ОписаниеПлатежа;
	ОплатаДата = Разбор.Оплата.ДатаОплаты;
	ОплатаИтог = Разбор.Оплата.Итог;
	СкидкаОписание = Разбор.Оплата.ОписаниеСкидки;
	СкидкаПроцент = Разбор.Оплата.ПроцентСкидки;
	СкидкаСумма = Разбор.Оплата.СуммаСкидки;

	СыройОтвет = Обработка.ЗаписатьУзелВТекст(СыройЗаказ);

КонецПроцедуры

&НаСервере
Процедура ОчиститьКарточку()

	СтрокиЗаказа.Очистить();
	ДополнительныеПоляЗаказа.Очистить();

	ПокупательФамилия = "";
	ПокупательИмя = "";
	ПокупательТелефон = "";
	ПокупательПочта = "";
	ПокупательИНН = "";
	ПокупательКПП = "";
	ПокупательАдрес = "";

	ДоставкаСлужба = "";
	ДоставкаКодСлужбы = "";
	ДоставкаПунктВыдачи = "";
	ДоставкаСтоимость = 0;
	ДоставкаДата = Дата(1, 1, 1);
	ДоставкаОписание = "";

	ОплатаСостояние = "";
	ОплатаОписание = "";
	ОплатаДата = Дата(1, 1, 1);
	ОплатаИтог = 0;
	СкидкаОписание = "";
	СкидкаПроцент = 0;
	СкидкаСумма = 0;

	СыройОтвет = "";

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСледующуюСтраницу()

	Если Не ИдетЗагрузка Тогда
		Возврат;
	КонецЕсли;

	Итог = ЗагрузитьСтраницуНаСервере(НомерТекущейСтраницы);

	Если Не Итог.Продолжать Тогда
		ИдетЗагрузка = Ложь;
		Возврат;
	КонецЕсли;

	Если Не Итог.ПовторитьСтраницу Тогда
		Если НомерТекущейСтраницы >= ПределСтраниц Тогда
			ИдетЗагрузка = Ложь;
			СостояниеЗагрузки = "Остановлено: достигнут предел страниц. Загружено заказов: "
				+ Формат(Заказы.Количество(), "ЧГ=0; ЧН=0");
			Возврат;
		КонецЕсли;
		НомерТекущейСтраницы = НомерТекущейСтраницы + 1;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ЗагрузитьСледующуюСтраницу", Итог.ПаузаСекунд, Истина);

КонецПроцедуры

&НаСервере
Функция ЗагрузитьСтраницуНаСервере(НомерСтраницы)

	Итог = Новый Структура("Продолжать, ПовторитьСтраницу, ПаузаСекунд", Ложь, Ложь, 0.2);

	Обработка = РеквизитФормыВЗначение("Объект");
	ПараметрыЗапроса = Обработка.ПараметрыСоединенияПоАдресу(
		АдресМагазина, ИдентификаторКлюча, ПарольКлюча, Таймаут);

	Если НомерСтраницы = 1 Тогда
		СохранитьНастройкиВХранилище();
	КонецЕсли;

	Страница = Обработка.ЗапросСтраницыЗаказов(
		ИмяПлощадки(), ПараметрыЗапроса, НомерСтраницы, РазмерСтраницы, ПериодС);

	ЗаписатьВПротокол(Обработка, "GET", Страница.Путь, Страница.Ответ, ПопыткаСтраницы);

	Если Обработка.ЭтоВременныйОтказ(Страница.Ответ.КодСостояния) Тогда
		Если ПопыткаСтраницы > Обработка.ПределПовторов() Тогда
			СостояниеЗагрузки = "Магазин не ответил после "
				+ Формат(ПопыткаСтраницы, "ЧГ=0; ЧН=0") + " попыток. "
				+ Обработка.РасшифровкаКодаСостояния(Страница.Ответ.КодСостояния);
			Возврат Итог;
		КонецЕсли;

		Итог.Продолжать = Истина;
		Итог.ПовторитьСтраницу = Истина;
		Итог.ПаузаСекунд = Обработка.ЗадержкаПередПовтором(Страница.Ответ, ПопыткаСтраницы);
		СостояниеЗагрузки = "Повтор страницы " + Формат(НомерСтраницы, "ЧГ=0; ЧН=0")
			+ " через " + Формат(Итог.ПаузаСекунд, "ЧГ=0; ЧН=0") + " с";
		ПопыткаСтраницы = ПопыткаСтраницы + 1;
		Возврат Итог;
	КонецЕсли;

	Если Страница.Ответ.КодСостояния <> 200 Тогда
		СостояниеЗагрузки = "Остановлено. Код "
			+ Формат(Страница.Ответ.КодСостояния, "ЧГ=0; ЧН=0") + ". "
			+ Обработка.РасшифровкаКодаСостояния(Страница.Ответ.КодСостояния);
		Возврат Итог;
	КонецЕсли;

	ПопыткаСтраницы = 1;
	ДобавитьЗаказыВСписок(Обработка, Страница.Заказы);

	Если Не Страница.ЕстьЕще Тогда
		СостояниеЗагрузки = "Готово. Загружено заказов: " + Формат(Заказы.Количество(), "ЧГ=0; ЧН=0");
		Возврат Итог;
	КонецЕсли;

	СостояниеЗагрузки = "Страница " + Формат(НомерСтраницы, "ЧГ=0; ЧН=0")
		+ ", загружено заказов: " + Формат(Заказы.Количество(), "ЧГ=0; ЧН=0");

	Итог.Продолжать = Истина;
	Если Обработка.НужнаПаузаПоЛимиту(Страница.Ответ) Тогда
		Итог.ПаузаСекунд = 2;
		СостояниеЗагрузки = СостояниеЗагрузки + ". Пауза: подходим к пределу запросов магазина";
	КонецЕсли;

	Возврат Итог;

КонецФункции

&НаСервере
Процедура ДобавитьЗаказыВСписок(Обработка, СырыеЗаказы)

	Для Каждого СыройЗаказ Из СырыеЗаказы Цикл

		Шапка = Обработка.ШапкаЗаказаДляСписка(ИмяПлощадки(), СыройЗаказ);

		// Верхнюю границу периода магазин не принимает, отсекаем сами.
		Если ЗначениеЗаполнено(ПериодПо) И ЗначениеЗаполнено(Шапка.Изменен)
			И Шапка.Изменен > ПериодПо Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Заказы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Шапка);
		НоваяСтрока.СырыеДанные = Обработка.ЗаписатьУзелВТекст(СыройЗаказ);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПроверитьСвязьНаСервере()

	Если ПустаяСтрока(АдресМагазина) Тогда
		Возврат "Укажите адрес магазина.";
	КонецЕсли;

	Обработка = РеквизитФормыВЗначение("Объект");
	ПараметрыЗапроса = Обработка.ПараметрыСоединенияПоАдресу(
		АдресМагазина, ИдентификаторКлюча, ПарольКлюча, Таймаут);

	Путь = Обработка.ОписаниеПлощадки(ИмяПлощадки()).ПутьПроверкиСвязи;
	Ответ = Обработка.ВыполнитьЗапрос(ПараметрыЗапроса, "GET", Путь);
	ЗаписатьВПротокол(Обработка, "GET", Путь, Ответ);

	Если ЗначениеЗаполнено(Ответ.ОписаниеОшибки) Тогда
		Возврат "Соединение не установлено." + Символы.ПС
			+ "Если база работает в клиент-серверном режиме, наружу ходит сервер 1С,"
			+ " а не рабочее место: проверяйте доступ в интернет и прокси на сервере."
			+ Символы.ПС + Ответ.ОписаниеОшибки;
	КонецЕсли;

	СохранитьНастройкиВХранилище();

	Возврат "Код " + Формат(Ответ.КодСостояния, "ЧГ=0; ЧН=0") + ". "
		+ Обработка.РасшифровкаКодаСостояния(Ответ.КодСостояния);

КонецФункции

&НаСервере
Процедура ЗаписатьВПротокол(Обработка, Метод, Путь, Ответ, НомерПопытки = 1, Комментарий = "")

	НоваяСтрока = ПротоколЗапросов.Добавить();
	НоваяСтрока.Момент = ТекущаяДата();
	НоваяСтрока.Метод = Метод;
	НоваяСтрока.Путь = Путь;
	НоваяСтрока.Код = Ответ.КодСостояния;
	НоваяСтрока.ДлительностьМс = Ответ.ДлительностьМс;
	НоваяСтрока.Попытка = НомерПопытки;
	НоваяСтрока.Лимит = Обработка.ПредставлениеОстаткаЛимита(Ответ.Заголовки);

	Если ЗначениеЗаполнено(Комментарий) Тогда
		НоваяСтрока.Комментарий = Комментарий;
	Иначе
		НоваяСтрока.Комментарий = Ответ.ОписаниеОшибки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ИмяПлощадки()

	Возврат РеквизитФормыВЗначение("Объект").ПлощадкаПоУмолчанию();

КонецФункции

#КонецОбласти

