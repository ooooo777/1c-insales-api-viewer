#Область Транспорт

// Разбирает адрес магазина на составляющие.
//
// Параметры:
//  АдресСтрокой - Строка - адрес вида "https://shop.example.ru" или "shop.example.ru".
//
// Возвращаемое значение:
//  Структура - Схема, Хост, Порт, Путь.
//
Функция РазобратьАдресМагазина(АдресСтрокой) Экспорт

	Результат = Новый Структура("Схема, Хост, Порт, Путь", "https", "", 443, "");

	Адрес = СокрЛП(АдресСтрокой);
	Если ПустаяСтрока(Адрес) Тогда
		Возврат Результат;
	КонецЕсли;

	Если СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Результат.Схема = "http";
		Результат.Порт = 80;
		Адрес = Сред(Адрес, 8);
	ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Адрес = Сред(Адрес, 9);
	КонецЕсли;

	ПозицияПути = СтрНайти(Адрес, "/");
	Если ПозицияПути > 0 Тогда
		Результат.Путь = Сред(Адрес, ПозицияПути);
		Адрес = Лев(Адрес, ПозицияПути - 1);
	КонецЕсли;

	ПозицияПорта = СтрНайти(Адрес, ":");
	Если ПозицияПорта > 0 Тогда
		Попытка
			Результат.Порт = Число(Сред(Адрес, ПозицияПорта + 1));
		Исключение
			Результат.Порт = ?(Результат.Схема = "http", 80, 443);
		КонецПопытки;
		Адрес = Лев(Адрес, ПозицияПорта - 1);
	КонецЕсли;

	Результат.Хост = Адрес;

	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//  Структура - Хост, Порт, Защищенное, Пользователь, Пароль, Таймаут.
//
Функция НовыеПараметрыСоединения() Экспорт

	Возврат Новый Структура("Хост, Порт, Защищенное, Пользователь, Пароль, Таймаут",
		"", 443, Истина, "", "", 60);

КонецФункции

// Заполняет параметры соединения по введённым на форме значениям.
//
// Параметры:
//  АдресМагазина - Строка - адрес магазина.
//  Идентификатор - Строка - идентификатор ключа доступа.
//  Пароль - Строка - пароль ключа доступа.
//  Таймаут - Число - таймаут запроса в секундах.
//
// Возвращаемое значение:
//  Структура - см. НовыеПараметрыСоединения.
//
Функция ПараметрыСоединенияПоАдресу(АдресМагазина, Идентификатор, Пароль, Таймаут) Экспорт

	Адрес = РазобратьАдресМагазина(АдресМагазина);

	Параметры = НовыеПараметрыСоединения();
	Параметры.Хост = Адрес.Хост;
	Параметры.Порт = Адрес.Порт;
	Параметры.Защищенное = (Адрес.Схема = "https");
	Параметры.Пользователь = СокрЛП(Идентификатор);
	Параметры.Пароль = Пароль;
	Параметры.Таймаут = ?(Таймаут > 0, Таймаут, 60);

	Возврат Параметры;

КонецФункции

// Выполняет запрос к магазину.
//
// Параметры:
//  ПараметрыСоединения - Структура - см. НовыеПараметрыСоединения.
//  Метод - Строка - "GET".
//  Путь - Строка - путь с параметрами запроса.
//
// Возвращаемое значение:
//  Структура - КодСостояния, Заголовки, Тело, ДлительностьМс, ОписаниеОшибки.
//
Функция ВыполнитьЗапрос(ПараметрыСоединения, Метод, Путь) Экспорт

	Результат = Новый Структура("КодСостояния, Заголовки, Тело, ДлительностьМс, ОписаниеОшибки",
		0, Новый Соответствие, "", 0, "");

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Если ПараметрыСоединения.Защищенное Тогда
			Защита = ЗащитаСоединения();
		Иначе
			Защита = Неопределено;
		КонецЕсли;

		Соединение = Новый HTTPСоединение(
			ПараметрыСоединения.Хост,
			ПараметрыСоединения.Порт,
			ПараметрыСоединения.Пользователь,
			ПараметрыСоединения.Пароль,
			Новый ИнтернетПрокси(Истина),
			ПараметрыСоединения.Таймаут,
			Защита);

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");

		Запрос = Новый HTTPЗапрос(Путь, Заголовки);

		Если ВРег(Метод) = "GET" Тогда
			Ответ = Соединение.Получить(Запрос);
		Иначе
			ВызватьИсключение "Метод " + Метод + " обработкой не поддерживается: она только читает данные.";
		КонецЕсли;

		Результат.КодСостояния = Ответ.КодСостояния;
		Результат.Заголовки = Ответ.Заголовки;
		Результат.Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		Результат.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Результат.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Возврат Результат;

КонецФункции

// Описание защищённого соединения.
//
// Сертификаты удостоверяющих центров берутся из хранилища операционной системы:
// список магазина тогда не зависит от того, что поставлено вместе с платформой.
// Объект такого списка появился не во всех версиях платформы, поэтому при неудаче
// соединение создаётся без явного списка и платформа берёт свой.
//
// Возвращаемое значение:
//  ЗащищенноеСоединениеOpenSSL - описание защиты для HTTPСоединение.
//
Функция ЗащитаСоединения()

	Попытка
		Возврат Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
	Исключение
		Возврат Новый ЗащищенноеСоединениеOpenSSL();
	КонецПопытки;

КонецФункции

// Объясняет код ответа магазина словами.
//
// Параметры:
//  Код - Число - код состояния HTTP.
//
// Возвращаемое значение:
//  Строка - объяснение для пользователя.
//
Функция РасшифровкаКодаСостояния(Код) Экспорт

	Если Код = 200 Или Код = 201 Тогда
		Возврат "Связь есть, магазин ответил.";
	ИначеЕсли Код = 400 Тогда
		Возврат "Магазин не принял запрос: проверьте адрес и параметры отбора.";
	ИначеЕсли Код = 401 Тогда
		Возврат "Неверный идентификатор или пароль ключа доступа.";
	ИначеЕсли Код = 403 Тогда
		Возврат "Ключ доступа есть, но прав на эти данные у него нет.";
	ИначеЕсли Код = 404 Тогда
		Возврат "Адрес магазина указан неверно либо метод недоступен.";
	ИначеЕсли Код = 429 Тогда
		Возврат "Превышен лимит запросов магазина. Подождите и повторите.";
	ИначеЕсли Код = 500 Тогда
		Возврат "Внутренняя ошибка магазина.";
	ИначеЕсли Код = 504 Тогда
		Возврат "Магазин не успел ответить за отведённое время.";
	КонецЕсли;

	Возврат "Магазин вернул код " + Формат(Код, "ЧГ=0") + ".";

КонецФункции

// Разбирает заголовок с остатком лимита запросов.
// Магазин присылает имя заголовка в нижнем регистре, значение вида "148/500".
//
// Параметры:
//  Заголовки - Соответствие - заголовки ответа.
//
// Возвращаемое значение:
//  Структура - Использовано, Предел. Неопределено, если заголовка нет.
//
Функция ОстатокЛимитаЗапросов(Заголовки) Экспорт

	Значение = "";
	Для Каждого Заголовок Из Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "api-usage-limit" Тогда
			Значение = Заголовок.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Части = СтрРазделить(Значение, "/", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Использовано, Предел", 0, 0);
	Попытка
		Результат.Использовано = Число(СокрЛП(Части[0]));
		Результат.Предел = Число(СокрЛП(Части[1]));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Представление остатка лимита для протокола.
//
// Параметры:
//  Заголовки - Соответствие - заголовки ответа.
//
// Возвращаемое значение:
//  Строка - например "148 из 500". Пустая строка, если заголовка нет.
//
Функция ПредставлениеОстаткаЛимита(Заголовки) Экспорт

	Лимит = ОстатокЛимитаЗапросов(Заголовки);
	Если Лимит = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Лимит.Использовано, "ЧГ=0") + " из " + Формат(Лимит.Предел, "ЧГ=0");

КонецФункции

// Признак отказа, который имеет смысл повторить.
// Ноль означает, что ответа не было вовсе: обрыв связи или таймаут.
//
// Параметры:
//  КодСостояния - Число - код ответа магазина.
//
// Возвращаемое значение:
//  Булево - повторять ли запрос.
//
Функция ЭтоВременныйОтказ(КодСостояния) Экспорт

	Возврат КодСостояния = 0
		Или КодСостояния = 429
		Или КодСостояния = 500
		Или КодСостояния = 502
		Или КодСостояния = 503
		Или КодСостояния = 504;

КонецФункции

// Сколько ждать перед повтором.
// Если магазин прислал Retry-After, слушаемся его; иначе удваиваем задержку.
//
// Параметры:
//  Ответ - Структура - см. ВыполнитьЗапрос.
//  НомерПопытки - Число - номер уже выполненной попытки, начиная с 1.
//
// Возвращаемое значение:
//  Число - секунды, не более 60.
//
Функция ЗадержкаПередПовтором(Ответ, НомерПопытки) Экспорт

	Для Каждого Заголовок Из Ответ.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "retry-after" Тогда
			Попытка
				Возврат Мин(Число(СокрЛП(Заголовок.Значение)), 60);
			Исключение
				Прервать;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Задержка = 1;
	Для Счетчик = 1 По Мин(НомерПопытки, 5) Цикл
		Задержка = Задержка * 2;
	КонецЦикла;

	Возврат Мин(Задержка, 30);

КонецФункции

// Нужна ли упреждающая пауза: до предела запросов осталось мало.
//
// Параметры:
//  Ответ - Структура - см. ВыполнитьЗапрос.
//
// Возвращаемое значение:
//  Булево - делать ли паузу перед следующим запросом.
//
Функция НужнаПаузаПоЛимиту(Ответ) Экспорт

	Лимит = ОстатокЛимитаЗапросов(Ответ.Заголовки);
	Если Лимит = Неопределено Или Лимит.Предел = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат (Лимит.Предел - Лимит.Использовано) <= 25;

КонецФункции

// Предельное число попыток одного запроса.
//
// Возвращаемое значение:
//  Число - сколько раз повторять, не считая первой попытки.
//
Функция ПределПовторов() Экспорт

	Возврат 3;

КонецФункции

#КонецОбласти

#Область АдаптерПлощадки

// Адаптер знает устройство конкретного магазина: адреса методов, постраничность,
// имена полей и значения статусов. Форма об этом не знает ничего.
// Вторая площадка добавляется ещё одной веткой в функциях этой области.

// Список поддерживаемых площадок.
//
// Возвращаемое значение:
//  Массив из Строка - имена площадок.
//
Функция ПоддерживаемыеПлощадки() Экспорт

	Результат = Новый Массив;
	Результат.Добавить("InSales");

	Возврат Результат;

КонецФункции

// Площадка, с которой обработка работает по умолчанию.
// Форма спрашивает имя здесь и сама его не знает: так имена площадок
// и их полей остаются в одном ярусе.
//
// Возвращаемое значение:
//  Строка - имя площадки.
//
Функция ПлощадкаПоУмолчанию() Экспорт

	Возврат ПоддерживаемыеПлощадки()[0];

КонецФункции

// Описание площадки для формы: как называются поля подключения и что писать в подсказках.
//
// Параметры:
//  ИмяПлощадки - Строка - см. ПоддерживаемыеПлощадки.
//
// Возвращаемое значение:
//  Структура - Представление, ПодсказкаАдреса, ПодсказкаКлюча, ПутьПроверкиСвязи.
//
Функция ОписаниеПлощадки(ИмяПлощадки) Экспорт

	Результат = Новый Структура(
		"Представление, ПодсказкаАдреса, ПодсказкаКлюча, ПутьПроверкиСвязи");

	Если ИмяПлощадки = "InSales" Тогда
		Результат.Представление = "InSales";
		Результат.ПодсказкаАдреса = "Адрес магазина, например https://мой-магазин.myinsales.ru";
		Результат.ПодсказкаКлюча = "Идентификатор и пароль ключа доступа из раздела"
			+ " «Приложения – Разработчикам – Ключи доступа»";
		Результат.ПутьПроверкиСвязи = "/admin/domains.json";
	Иначе
		ВызватьИсключение "Площадка «" + ИмяПлощадки + "» не поддерживается.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Граница периода в том виде, в каком её принимает магазин.
// Смещение от UTC обязательно: без него магазин читает время как UTC
// и сдвигает границу на величину часового пояса.
//
// Параметры:
//  ДатаЛокальная - Дата - дата в часовом поясе сеанса.
//
// Возвращаемое значение:
//  Строка - например 2026-09-01T00:00:00+03:00.
//
Функция ГраницаПериодаДляЗапроса(ДатаЛокальная) Экспорт

	СмещениеСекунд = ТекущаяДата() - ТекущаяУниверсальнаяДата();

	Если СмещениеСекунд < 0 Тогда
		Знак = "-";
		СмещениеСекунд = -СмещениеСекунд;
	Иначе
		Знак = "+";
	КонецЕсли;

	Часы = Цел(СмещениеСекунд / 3600);
	Минуты = Цел((СмещениеСекунд - Часы * 3600) / 60);

	// Дополняем нулём слева вручную: формат с ведущими нулями для нуля
	// даёт пустую строку, и смещение вида +03:00 превращается в +03:.
	ЧасыСтрокой = Прав("0" + Строка(Часы), 2);
	МинутыСтрокой = Прав("0" + Строка(Минуты), 2);

	Возврат Формат(ДатаЛокальная, "ДФ=yyyy-MM-ddTHH:mm:ss") + Знак
		+ ЧасыСтрокой + ":" + МинутыСтрокой;

КонецФункции

// Путь запроса страницы заказов.
// Разделитель параметров — амперсанд: с точкой с запятой магазин игнорирует
// размер страницы и отдаёт по двадцать пять записей.
// Знак плюс в смещении границы кодируется: незакодированный плюс магазин
// читает как пробел, теряет смещение и сдвигает границу на величину пояса.
//
// Параметры:
//  ИмяПлощадки - Строка - см. ПоддерживаемыеПлощадки.
//  НомерСтраницы - Число - начиная с единицы.
//  РазмерСтраницы - Число - сколько заказов просить.
//  ИзмененыС - Дата - нижняя граница по дате изменения, может быть пустой.
//
// Возвращаемое значение:
//  Строка - путь с параметрами запроса.
//
Функция ПутьСтраницыЗаказов(ИмяПлощадки, НомерСтраницы, РазмерСтраницы, ИзмененыС) Экспорт

	Если ИмяПлощадки <> "InSales" Тогда
		ВызватьИсключение "Площадка «" + ИмяПлощадки + "» не поддерживается.";
	КонецЕсли;

	Путь = "/admin/orders.json?page=" + Формат(НомерСтраницы, "ЧГ=0")
		+ "&per_page=" + Формат(РазмерСтраницы, "ЧГ=0");

	Если ЗначениеЗаполнено(ИзмененыС) Тогда
		Путь = Путь + "&updated_since="
			+ СтрЗаменить(ГраницаПериодаДляЗапроса(ИзмененыС), "+", "%2B");
	КонецЕсли;

	Возврат Путь;

КонецФункции

// Запрашивает одну страницу заказов.
//
// Параметры:
//  ИмяПлощадки - Строка - см. ПоддерживаемыеПлощадки.
//  ПараметрыСоединения - Структура - см. НовыеПараметрыСоединения.
//  НомерСтраницы - Число - начиная с единицы.
//  РазмерСтраницы - Число - сколько заказов просить.
//  ИзмененыС - Дата - нижняя граница по дате изменения.
//
// Возвращаемое значение:
//  Структура - Заказы (Массив из Соответствие), ЕстьЕще, Путь, Ответ.
//
Функция ЗапросСтраницыЗаказов(ИмяПлощадки, ПараметрыСоединения, НомерСтраницы,
		РазмерСтраницы, ИзмененыС) Экспорт

	Результат = Новый Структура("Заказы, ЕстьЕще, Путь, Ответ",
		Новый Массив, Ложь, "", Неопределено);

	Результат.Путь = ПутьСтраницыЗаказов(ИмяПлощадки, НомерСтраницы, РазмерСтраницы, ИзмененыС);

	Ответ = ВыполнитьЗапрос(ПараметрыСоединения, "GET", Результат.Путь);
	Результат.Ответ = Ответ;

	Если Ответ.КодСостояния <> 200 Или ПустаяСтрока(Ответ.Тело) Тогда
		Возврат Результат;
	КонецЕсли;

	Данные = ПрочитатьОтветВСоответствие(Ответ.Тело);
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Результат.Заказы = Данные;
	КонецЕсли;

	Результат.ЕстьЕще = (Результат.Заказы.Количество() > 0);

	Возврат Результат;

КонецФункции

// Читает тело ответа. Ключи читаются в соответствие, а не в структуру:
// у магазина есть имена полей, недопустимые как идентификаторы встроенного языка.
//
// Параметры:
//  ТелоОтвета - Строка - тело ответа магазина.
//
// Возвращаемое значение:
//  Произвольный - Массив, Соответствие либо Неопределено, если разбор не удался.
//
Функция ПрочитатьОтветВСоответствие(ТелоОтвета) Экспорт

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Данные;

КонецФункции

// Поля заказа, которые показываются в списке.
//
// Параметры:
//  ИмяПлощадки - Строка - см. ПоддерживаемыеПлощадки.
//  СыройЗаказ - Соответствие - один заказ из ответа магазина.
//
// Возвращаемое значение:
//  Структура - поля строки списка заказов.
//
Функция ШапкаЗаказаДляСписка(ИмяПлощадки, СыройЗаказ) Экспорт

	Если ИмяПлощадки <> "InSales" Тогда
		ВызватьИсключение "Площадка «" + ИмяПлощадки + "» не поддерживается.";
	КонецЕсли;

	Результат = Новый Структура(
		"НомерНаСайте, Идентификатор, Создан, Изменен, Покупатель, Сумма, Оплачен,"
		+ " СтатусВыполнения, СлужбаДоставки, СтоимостьДоставки, ЧислоСтрок");

	Результат.НомерНаСайте = ЗначениеПоля(СыройЗаказ, "number");
	Результат.Идентификатор = ЗначениеПоля(СыройЗаказ, "id");
	Результат.Создан = ДатаИзОтвета(ЗначениеПоля(СыройЗаказ, "created_at"));
	Результат.Изменен = ДатаИзОтвета(ЗначениеПоля(СыройЗаказ, "updated_at"));
	Результат.Сумма = ЧислоИзОтвета(СыройЗаказ.Получить("total_price"));
	Результат.Оплачен = (ЗначениеПоля(СыройЗаказ, "financial_status") = "paid");
	Результат.СтатусВыполнения = ЗначениеПоля(СыройЗаказ, "fulfillment_status");
	Результат.СтоимостьДоставки = ЧислоИзОтвета(СыройЗаказ.Получить("delivery_price"));

	Клиент = СыройЗаказ.Получить("client");
	Если ТипЗнч(Клиент) = Тип("Соответствие") Тогда
		Результат.Покупатель = СокрЛП(СокрЛП(ЗначениеПоля(Клиент, "surname")) + " "
			+ СокрЛП(ЗначениеПоля(Клиент, "name")));
	Иначе
		Результат.Покупатель = "";
	КонецЕсли;

	Результат.СлужбаДоставки = ЗначениеПоля(СыройЗаказ, "delivery_title");
	Если ПустаяСтрока(Результат.СлужбаДоставки) Тогда
		Доставка = СыройЗаказ.Получить("delivery_info");
		Если ТипЗнч(Доставка) = Тип("Соответствие") Тогда
			Результат.СлужбаДоставки = ЗначениеПоля(Доставка, "title");
		КонецЕсли;
	КонецЕсли;

	Если Результат.СтоимостьДоставки = 0 Тогда
		Результат.СтоимостьДоставки = ЧислоИзОтвета(СыройЗаказ.Получить("full_delivery_price"));
	КонецЕсли;

	Строки = СыройЗаказ.Получить("order_lines");
	Если ТипЗнч(Строки) = Тип("Массив") Тогда
		Результат.ЧислоСтрок = Строки.Количество();
	Иначе
		Результат.ЧислоСтрок = 0;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Значение поля как строка. Отсутствующее поле даёт пустую строку.
//
// Параметры:
//  Узел - Соответствие - узел ответа.
//  Имя - Строка - имя поля.
//
// Возвращаемое значение:
//  Строка - значение поля.
//
Функция ЗначениеПоля(Узел, Имя) Экспорт

	Если ТипЗнч(Узел) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Узел.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// Числа приводим сами: Строка() расставляет разделители групп,
	// и идентификатор товара превращается в «1 885 247 385».
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧН=0");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Число из значения, которое магазин отдаёт строкой с точкой.
//
// Параметры:
//  Значение - Произвольный - значение поля ответа.
//
// Возвращаемое значение:
//  Число - разобранное число либо ноль.
//
Функция ЧислоИзОтвета(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Текст);
	Исключение
	КонецПопытки;

	Попытка
		Возврат Число(СтрЗаменить(Текст, ".", ","));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Дата из строки вида 2026-09-01T14:48:29+03:00.
// Разбираем позиционно: формат магазина фиксирован, а разбор строки
// встроенными средствами зависит от региональных настроек сеанса.
//
// Параметры:
//  Значение - Строка - значение поля ответа.
//
// Возвращаемое значение:
//  Дата - разобранная дата либо пустая дата.
//
Функция ДатаИзОтвета(Значение) Экспорт

	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) < 19 Тогда
		Возврат ПустаяДата();
	КонецЕсли;

	Попытка
		Год = Число(Сред(Текст, 1, 4));
		Месяц = Число(Сред(Текст, 6, 2));
		День = Число(Сред(Текст, 9, 2));
		Час = Число(Сред(Текст, 12, 2));
		Минута = Число(Сред(Текст, 15, 2));
		Секунда = Число(Сред(Текст, 18, 2));
		Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Возврат ПустаяДата();
	КонецПопытки;

КонецФункции

// Пустая дата.
//
// Возвращаемое значение:
//  Дата - начало отсчёта дат платформы.
//
Функция ПустаяДата() Экспорт

	Возврат Дата(1, 1, 1);

КонецФункции

// Записывает узел ответа обратно в текст JSON с отступами.
// Нужен, чтобы показать пользователю сырой ответ по выделенному заказу.
//
// Параметры:
//  Узел - Произвольный - соответствие, массив или примитив из ответа магазина.
//
// Возвращаемое значение:
//  Строка - текст JSON. Пустая строка, если записать не удалось.
//
Функция ЗаписатьУзелВТекст(Узел) Экспорт

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
		ЗаписатьJSON(Запись, Узел);
		Возврат Запись.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Разбирает заказ в плоские структуры и таблицы для карточки.
//
// Параметры:
//  ИмяПлощадки - Строка - см. ПоддерживаемыеПлощадки.
//  СыройЗаказ - Соответствие - один заказ из ответа магазина.
//
// Возвращаемое значение:
//  Структура - Строки, Покупатель, Доставка, Оплата, ДополнительныеПоля.
//
Функция РазобратьЗаказ(ИмяПлощадки, СыройЗаказ) Экспорт

	Если ИмяПлощадки <> "InSales" Тогда
		ВызватьИсключение "Площадка «" + ИмяПлощадки + "» не поддерживается.";
	КонецЕсли;

	Результат = Новый Структура("Строки, Покупатель, Доставка, Оплата, ДополнительныеПоля");

	Результат.Строки = СтрокиЗаказа(СыройЗаказ);
	Результат.Покупатель = ПокупательЗаказа(СыройЗаказ);
	Результат.Доставка = ДоставкаЗаказа(СыройЗаказ);
	Результат.Оплата = ОплатаЗаказа(СыройЗаказ);
	Результат.ДополнительныеПоля = ДополнительныеПоляЗаказа(СыройЗаказ);

	Возврат Результат;

КонецФункции

// Строки заказа.
// Колонка «ключ сопоставления» собирается из идентификаторов товара и варианта:
// именно по ним интеграция связывает строку заказа с номенклатурой учётной системы.
//
// Параметры:
//  СыройЗаказ - Соответствие - один заказ из ответа магазина.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки заказа.
//
Функция СтрокиЗаказа(СыройЗаказ) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("КлючСопоставления", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Скидка", Новый ОписаниеТипов("Число"));

	ИсходныеСтроки = СыройЗаказ.Получить("order_lines");
	Если ТипЗнч(ИсходныеСтроки) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ИсходнаяСтрока Из ИсходныеСтроки Цикл

		Если ТипЗнч(ИсходнаяСтрока) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Артикул = ЗначениеПоля(ИсходнаяСтрока, "sku");
		НоваяСтрока.Наименование = ЗначениеПоля(ИсходнаяСтрока, "title");
		НоваяСтрока.Штрихкод = ЗначениеПоля(ИсходнаяСтрока, "barcode");
		НоваяСтрока.Количество = ЧислоИзОтвета(ИсходнаяСтрока.Получить("quantity"));
		НоваяСтрока.Цена = ЧислоИзОтвета(ИсходнаяСтрока.Получить("sale_price"));
		НоваяСтрока.Сумма = ЧислоИзОтвета(ИсходнаяСтрока.Получить("total_price"));
		НоваяСтрока.Скидка = ЧислоИзОтвета(ИсходнаяСтрока.Получить("discounts_amount"));

		ИдентификаторТовара = ЗначениеПоля(ИсходнаяСтрока, "product_id");
		ИдентификаторВарианта = ЗначениеПоля(ИсходнаяСтрока, "variant_id");
		Если ПустаяСтрока(ИдентификаторВарианта) Тогда
			НоваяСтрока.КлючСопоставления = ИдентификаторТовара;
		Иначе
			НоваяСтрока.КлючСопоставления = ИдентификаторТовара + " / " + ИдентификаторВарианта;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Покупатель и адрес доставки.
//
// Параметры:
//  СыройЗаказ - Соответствие - один заказ из ответа магазина.
//
// Возвращаемое значение:
//  Структура - поля покупателя.
//
Функция ПокупательЗаказа(СыройЗаказ) Экспорт

	Результат = Новый Структура("Имя, Фамилия, Телефон, Почта, ИНН, КПП, Адрес",
		"", "", "", "", "", "", "");

	Клиент = СыройЗаказ.Получить("client");
	Если ТипЗнч(Клиент) = Тип("Соответствие") Тогда
		Результат.Имя = ЗначениеПоля(Клиент, "name");
		Результат.Фамилия = ЗначениеПоля(Клиент, "surname");
		Результат.Телефон = ЗначениеПоля(Клиент, "phone");
		Результат.Почта = ЗначениеПоля(Клиент, "email");
		Результат.ИНН = ЗначениеПоля(Клиент, "inn");
		Результат.КПП = ЗначениеПоля(Клиент, "kpp");
	КонецЕсли;

	АдресДоставки = СыройЗаказ.Получить("shipping_address");
	Если ТипЗнч(АдресДоставки) = Тип("Соответствие") Тогда
		Полный = ЗначениеПоля(АдресДоставки, "full_delivery_address");
		Если ПустаяСтрока(Полный) Тогда
			Полный = ЗначениеПоля(АдресДоставки, "address");
		КонецЕсли;
		Результат.Адрес = Полный;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Доставка заказа.
// Машинный код службы — это то, по чему строится сопоставление служб доставки;
// пункт выдачи заполнен только для доставки в пункт, у курьерской он пустой.
//
// Параметры:
//  СыройЗаказ - Соответствие - один заказ из ответа магазина.
//
// Возвращаемое значение:
//  Структура - поля доставки.
//
Функция ДоставкаЗаказа(СыройЗаказ) Экспорт

	Результат = Новый Структура(
		"Служба, МашинныйКодСлужбы, ПунктВыдачи, Стоимость, Дата, Описание",
		"", "", "", 0, ПустаяДата(), "");

	// Название способа доставки магазин кладёт в delivery_title, а вложенный
	// delivery_info.title заполняет только для служб со своим тарифом. Поэтому
	// сначала берём верхний уровень и лишь потом подробности.
	Результат.Служба = ЗначениеПоля(СыройЗаказ, "delivery_title");
	Результат.Описание = ЗначениеПоля(СыройЗаказ, "delivery_description");
	Результат.Стоимость = ЧислоИзОтвета(СыройЗаказ.Получить("delivery_price"));
	Результат.Дата = ДатаИзОтвета(ЗначениеПоля(СыройЗаказ, "delivery_date"));

	Если Результат.Стоимость = 0 Тогда
		Результат.Стоимость = ЧислоИзОтвета(СыройЗаказ.Получить("full_delivery_price"));
	КонецЕсли;

	Доставка = СыройЗаказ.Получить("delivery_info");
	Если ТипЗнч(Доставка) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(Результат.Служба) Тогда
		Результат.Служба = ЗначениеПоля(Доставка, "title");
	КонецЕсли;

	Если ПустаяСтрока(Результат.Служба) Тогда
		Результат.Служба = ЗначениеПоля(Доставка, "shipping_company");
	КонецЕсли;

	Результат.МашинныйКодСлужбы = ЗначениеПоля(Доставка, "shipping_company_handle");

	Если Результат.Стоимость = 0 Тогда
		Результат.Стоимость = ЧислоИзОтвета(Доставка.Получить("price"));
	КонецЕсли;

	// Пункт выдачи показываем так, как его узнаёт человек: название, затем адрес.
	// Идентификатор остаётся последним доводом, когда магазин прислал только его.
	Пункт = Доставка.Получить("outlet");
	Если ТипЗнч(Пункт) = Тип("Соответствие") Тогда
		Результат.ПунктВыдачи = ЗначениеПоля(Пункт, "title");
		Если ПустаяСтрока(Результат.ПунктВыдачи) Тогда
			Результат.ПунктВыдачи = ЗначениеПоля(Пункт, "address");
		КонецЕсли;
		Если ПустаяСтрока(Результат.ПунктВыдачи) Тогда
			Результат.ПунктВыдачи = ЗначениеПоля(Пункт, "id");
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Оплата и скидка заказа.
//
// Параметры:
//  СыройЗаказ - Соответствие - один заказ из ответа магазина.
//
// Возвращаемое значение:
//  Структура - поля оплаты.
//
Функция ОплатаЗаказа(СыройЗаказ) Экспорт

	Результат = Новый Структура(
		"Состояние, ОписаниеПлатежа, ДатаОплаты, Итог, ОписаниеСкидки, ПроцентСкидки, СуммаСкидки",
		"", "", ПустаяДата(), 0, "", 0, 0);

	Результат.Состояние = ЗначениеПоля(СыройЗаказ, "financial_status");
	Результат.ОписаниеПлатежа = ЗначениеПоля(СыройЗаказ, "payment_description");
	Результат.ДатаОплаты = ДатаИзОтвета(ЗначениеПоля(СыройЗаказ, "paid_at"));
	Результат.Итог = ЧислоИзОтвета(СыройЗаказ.Получить("total_price"));

	Скидка = СыройЗаказ.Получить("discount");
	Если ТипЗнч(Скидка) = Тип("Соответствие") Тогда
		Результат.ОписаниеСкидки = ЗначениеПоля(Скидка, "description");
		Результат.ПроцентСкидки = ЧислоИзОтвета(Скидка.Получить("percent"));
		Результат.СуммаСкидки = ЧислоИзОтвета(Скидка.Получить("full_amount"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Дополнительные поля заказа: их не видно нигде, кроме программного интерфейса.
//
// Параметры:
//  СыройЗаказ - Соответствие - один заказ из ответа магазина.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Имя, Значение.
//
Функция ДополнительныеПоляЗаказа(СыройЗаказ) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));

	ИсходныеПоля = СыройЗаказ.Получить("fields_values");
	Если ТипЗнч(ИсходныеПоля) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Поле Из ИсходныеПоля Цикл

		Если ТипЗнч(Поле) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Имя = ЗначениеПоля(Поле, "name");
		НоваяСтрока.Значение = ЗначениеПоля(Поле, "value");

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОписаниеДляБиблиотеки

// Описание обработки для механизма дополнительных обработок учётной системы.
// Возвращает структуру из строк и ничего не вызывает: в базе, где такого механизма
// нет, функция просто не используется и работе не мешает.
//
// Безопасный режим выключен намеренно: в безопасном режиме платформа запрещает
// обработке исходящие соединения, а без них просмотрщик заказов бессмысленен.
// Это оговаривается в описании публикации.
//
// Возвращаемое значение:
//  Структура - Вид, Наименование, БезопасныйРежим, Версия, Информация, Команды.
//
Функция СведенияОВнешнейОбработке() Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("Вид", "ДополнительнаяОбработка");
	Сведения.Вставить("Наименование", "Просмотр заказов интернет-магазина InSales по API");
	Сведения.Вставить("БезопасныйРежим", Ложь);
	Сведения.Вставить("Версия", ВерсияОбработки());
	Сведения.Вставить("Информация",
		"Читает заказы интернет-магазина InSales по программному интерфейсу и показывает состав,"
		+ " покупателя, доставку, оплату и ответ магазина как есть."
		+ " Данные в информационную базу не записываются.");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	Команда = Команды.Добавить();
	Команда.Представление = "Просмотр заказов интернет-магазина";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Ложь;

	Сведения.Вставить("Команды", Команды);

	Возврат Сведения;

КонецФункции

// Версия обработки. Держится в одном месте: описание для учётной системы,
// карточка публикации и репозиторий должны называть одно и то же число.
//
// Возвращаемое значение:
//  Строка - версия вида 1.0.
//
Функция ВерсияОбработки() Экспорт

	Возврат "1.0";

КонецФункции

#КонецОбласти
